<?xml version="1.0" encoding="utf-8"?>
<!-- {{key}} placeholders are filled from Strings.cs (Chinese or English) when the ribbon loads. -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="tabSelExport" label="{{tab}}" insertAfterMso="TabView">
        <group id="grpExport" label="{{grp.export}}">
          <button id="btnPdf" label="{{pdf.label}}" size="large" getImage="GetImage" onAction="OnExportPdf"
                  screentip="{{pdf.tip}}" supertip="{{pdf.super}}" />
          <button id="btnSvg" label="{{svg.label}}" size="large" getImage="GetImage" onAction="OnExportSvg"
                  screentip="{{svg.tip}}" supertip="{{svg.super}}" />
          <button id="btnImage" label="{{img.label}}" size="large" getImage="GetImage" onAction="OnExportImage"
                  screentip="{{img.tip}}" supertip="{{img.super}}" />
        </group>
        <group id="grpBackground" label="{{grp.background}}">
          <toggleButton id="tglTransparent" label="{{transparent.label}}" size="large" getImage="GetImage"
                        getPressed="GetPressed" onAction="OnBackgroundMode"
                        screentip="{{transparent.label}}" supertip="{{transparent.super}}" />
          <splitButton id="splColor" size="large">
            <toggleButton id="tglColor" label="{{color.label}}" getImage="GetImage"
                          getPressed="GetPressed" onAction="OnBackgroundMode"
                          screentip="{{color.tip}}" getSupertip="GetColorSupertip" />
            <menu id="mnuColor" itemSize="normal">
              <button id="clrWhite" tag="FFFFFF" label="{{color.white}}" getImage="GetImage" onAction="OnPresetColor" />
              <button id="clrLightGray" tag="F2F2F2" label="{{color.lightgray}}" getImage="GetImage" onAction="OnPresetColor" />
              <button id="clrBlack" tag="000000" label="{{color.black}}" getImage="GetImage" onAction="OnPresetColor" />
              <button id="clrCream" tag="FFF8E1" label="{{color.cream}}" getImage="GetImage" onAction="OnPresetColor" />
              <button id="clrPaleBlue" tag="E8F1FB" label="{{color.paleblue}}" getImage="GetImage" onAction="OnPresetColor" />
              <menuSeparator id="sepColor" />
              <button id="btnMoreColors" label="{{color.more}}" getImage="GetImage" onAction="OnPickColor" />
            </menu>
          </splitButton>
        </group>
        <group id="grpOptions" label="{{grp.options}}">
          <dropDown id="ddDpi" label="{{dpi.label}}" sizeString="0000 DPI" getSelectedItemIndex="GetDpiIndex" onAction="OnDpiChanged"
                    screentip="{{dpi.label}}" supertip="{{dpi.super}}">
            <item id="dpi96" label="96 DPI" />
            <item id="dpi150" label="150 DPI" />
            <item id="dpi200" label="200 DPI" />
            <item id="dpi300" label="300 DPI" />
            <item id="dpi600" label="600 DPI" />
          </dropDown>
          <checkBox id="chkOpenFolder" label="{{openfolder.label}}" getPressed="GetPressed" onAction="OnOption"
                    screentip="{{openfolder.label}}" supertip="{{openfolder.super}}" />
        </group>
        <!-- three rows of icon-only buttons: a 3 x 3 grid -->
        <group id="grpAlign" label="{{grp.align}}" getImage="GetImage">
          <box id="boxAlignH" boxStyle="horizontal">
            <button id="btnAlignLeft" label="{{align.left.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{align.left.label}}" supertip="{{align.left.super}}" />
            <button id="btnAlignCenter" label="{{align.center.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{align.center.label}}" supertip="{{align.center.super}}" />
            <button id="btnAlignRight" label="{{align.right.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{align.right.label}}" supertip="{{align.right.super}}" />
          </box>
          <box id="boxAlignV" boxStyle="horizontal">
            <button id="btnAlignTop" label="{{align.top.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{align.top.label}}" supertip="{{align.top.super}}" />
            <button id="btnAlignMiddle" label="{{align.middle.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{align.middle.label}}" supertip="{{align.middle.super}}" />
            <button id="btnAlignBottom" label="{{align.bottom.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{align.bottom.label}}" supertip="{{align.bottom.super}}" />
          </box>
          <box id="boxDistribute" boxStyle="horizontal">
            <button id="btnDistributeH" label="{{distribute.h.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{distribute.h.label}}" supertip="{{distribute.h.super}}" />
            <button id="btnDistributeV" label="{{distribute.v.label}}" showLabel="false" getImage="GetImage" onAction="OnAlign"
                    screentip="{{distribute.v.label}}" supertip="{{distribute.v.super}}" />
            <toggleButton id="tglAlignToObject" label="{{toobject.label}}" showLabel="false" getImage="GetImage"
                          getPressed="GetPressed" onAction="OnAlignToObject"
                          screentip="{{toobject.label}}" supertip="{{toobject.super}}" />
          </box>
        </group>
        <!-- two rows of two icon-only buttons each -->
        <group id="grpRotate" label="{{grp.rotate}}" getImage="GetImage">
          <box id="boxRotate" boxStyle="horizontal">
            <button id="btnRotateLeft" label="{{rotate.left.label}}" showLabel="false" getImage="GetImage" onAction="OnTransform"
                    screentip="{{rotate.left.label}}" supertip="{{rotate.left.super}}" />
            <button id="btnRotateRight" label="{{rotate.right.label}}" showLabel="false" getImage="GetImage" onAction="OnTransform"
                    screentip="{{rotate.right.label}}" supertip="{{rotate.right.super}}" />
          </box>
          <box id="boxFlip" boxStyle="horizontal">
            <button id="btnFlipH" label="{{flip.h.label}}" showLabel="false" getImage="GetImage" onAction="OnTransform"
                    screentip="{{flip.h.label}}" supertip="{{flip.h.super}}" />
            <button id="btnFlipV" label="{{flip.v.label}}" showLabel="false" getImage="GetImage" onAction="OnTransform"
                    screentip="{{flip.v.label}}" supertip="{{flip.v.super}}" />
          </box>
        </group>
        <!-- stacking order: the top row moves up, the bottom row moves down -->
        <group id="grpOrder" label="{{grp.order}}" getImage="GetImage">
          <box id="boxOrderUp" boxStyle="horizontal">
            <button id="btnBringToFront" label="{{order.front.label}}" showLabel="false" getImage="GetImage" onAction="OnOrder"
                    screentip="{{order.front.label}}" supertip="{{order.front.super}}" />
            <button id="btnBringForward" label="{{order.forward.label}}" showLabel="false" getImage="GetImage" onAction="OnOrder"
                    screentip="{{order.forward.label}}" supertip="{{order.forward.super}}" />
          </box>
          <box id="boxOrderDown" boxStyle="horizontal">
            <button id="btnSendToBack" label="{{order.back.label}}" showLabel="false" getImage="GetImage" onAction="OnOrder"
                    screentip="{{order.back.label}}" supertip="{{order.back.super}}" />
            <button id="btnSendBackward" label="{{order.backward.label}}" showLabel="false" getImage="GetImage" onAction="OnOrder"
                    screentip="{{order.backward.label}}" supertip="{{order.backward.super}}" />
          </box>
        </group>
        <group id="grpMerge" label="{{grp.merge}}" getImage="GetImage">
          <box id="boxMerge1" boxStyle="horizontal">
            <button id="btnUnion" label="{{merge.union.label}}" showLabel="false" getImage="GetImage" onAction="OnMerge"
                    screentip="{{merge.union.label}}" supertip="{{merge.union.super}}" />
            <button id="btnCombine" label="{{merge.combine.label}}" showLabel="false" getImage="GetImage" onAction="OnMerge"
                    screentip="{{merge.combine.label}}" supertip="{{merge.combine.super}}" />
          </box>
          <box id="boxMerge2" boxStyle="horizontal">
            <button id="btnSubtract" label="{{merge.subtract.label}}" showLabel="false" getImage="GetImage" onAction="OnMerge"
                    screentip="{{merge.subtract.label}}" supertip="{{merge.subtract.super}}" />
            <button id="btnFragment" label="{{merge.fragment.label}}" showLabel="false" getImage="GetImage" onAction="OnMerge"
                    screentip="{{merge.fragment.label}}" supertip="{{merge.fragment.super}}" />
          </box>
        </group>
        <!-- fill and outline of the selected shapes: three rows of drop-down lists (colours, weight and dashes, cap type) -->
        <group id="grpStyle" label="{{grp.style}}" getImage="GetImage">
          <box id="boxStyleColor" boxStyle="horizontal">
            <gallery id="galFill" label="{{style.fill.label}}" getImage="GetImage" columns="12" itemWidth="18" itemHeight="18"
                     showItemLabel="false" getItemCount="GetColorCount" getItemID="GetColorId" getItemImage="GetColorImage"
                     getItemScreentip="GetColorTip" getSelectedItemIndex="GetColorIndex" onAction="OnColorPicked"
                     screentip="{{style.fill.tip}}" supertip="{{style.fill.super}}">
              <button id="btnFillNone" label="{{style.fill.none}}" getImage="GetImage" onAction="OnStyleButton" />
              <button id="btnFillMore" label="{{color.more}}" getImage="GetImage" onAction="OnStyleButton" />
            </gallery>
            <gallery id="galOutline" label="{{style.outline.label}}" getImage="GetImage" columns="12" itemWidth="18" itemHeight="18"
                     showItemLabel="false" getItemCount="GetColorCount" getItemID="GetColorId" getItemImage="GetColorImage"
                     getItemScreentip="GetColorTip" getSelectedItemIndex="GetColorIndex" onAction="OnColorPicked"
                     screentip="{{style.outline.tip}}" supertip="{{style.outline.super}}">
              <button id="btnOutlineNone" label="{{style.outline.none}}" getImage="GetImage" onAction="OnStyleButton" />
              <button id="btnOutlineMore" label="{{color.more}}" getImage="GetImage" onAction="OnStyleButton" />
            </gallery>
          </box>
          <box id="boxStyleLine" boxStyle="horizontal">
            <gallery id="galWeight" label="{{style.weight.label}}" getImage="GetImage" columns="1" itemWidth="96" itemHeight="18"
                     showItemLabel="true" getItemCount="GetWeightCount" getItemID="GetWeightId" getItemImage="GetWeightImage"
                     getItemLabel="GetWeightLabel" getSelectedItemIndex="GetWeightIndex" onAction="OnWeightPicked"
                     screentip="{{style.weight.tip}}" supertip="{{style.weight.super}}">
              <button id="btnWeightMore" label="{{style.weight.more}}" onAction="OnStyleButton" />
            </gallery>
            <gallery id="galDash" label="{{style.dash.label}}" getImage="GetImage" columns="1" itemWidth="96" itemHeight="18"
                     showItemLabel="true" getItemCount="GetDashCount" getItemID="GetDashId" getItemImage="GetDashImage"
                     getItemLabel="GetDashLabel" getSelectedItemIndex="GetDashIndex" onAction="OnDashPicked"
                     screentip="{{style.dash.tip}}" supertip="{{style.dash.super}}" />
          </box>
          <box id="boxStyleCap" boxStyle="horizontal">
            <gallery id="galCap" label="{{style.cap.label}}" getImage="GetImage" columns="1" itemWidth="96" itemHeight="18"
                     showItemLabel="true" getItemCount="GetCapCount" getItemID="GetCapId" getItemImage="GetCapImage"
                     getItemLabel="GetCapLabel" getSelectedItemIndex="GetCapIndex" onAction="OnCapPicked"
                     screentip="{{style.cap.tip}}" supertip="{{style.cap.super}}" />
          </box>
        </group>
        <!-- rows and columns: lay the selected shapes out as a matrix, or cut one into a matrix of pieces -->
        <group id="grpMatrix" label="{{grp.matrix}}" getImage="GetImage">
          <button id="btnMatrixLayout" label="{{matrix.layout.label}}" getImage="GetImage" onAction="OnMatrixLayout"
                  screentip="{{matrix.layout.tip}}" supertip="{{matrix.layout.super}}" />
          <button id="btnMatrixCut" label="{{matrix.cut.label}}" getImage="GetImage" onAction="OnMatrixCut"
                  screentip="{{matrix.cut.tip}}" supertip="{{matrix.cut.super}}" />
        </group>
        <!-- the size of the slides -->
        <group id="grpSlide" label="{{grp.slide}}">
          <button id="btnSlideSize" label="{{size.label}}" size="large" getImage="GetImage" onAction="OnSlideSize"
                  screentip="{{size.tip}}" supertip="{{size.super}}" />
        </group>
        <!-- tools for the whole file -->
        <group id="grpFile" label="{{grp.file}}">
          <button id="btnSlim" label="{{slim.label}}" size="large" getImage="GetImage" onAction="OnSlim"
                  screentip="{{slim.tip}}" supertip="{{slim.super}}" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
